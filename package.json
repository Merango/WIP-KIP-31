{
  "name": "kip-31-core-testing",
  "version": "0.1.0",
  "description": "Core testing framework for KIP-31",
  "type": "module",
  "scripts": {
    "test": "npx --node-options=--experimental-vm-modules jest",
    "test:watch": "npx --node-options=--experimental-vm-modules jest --watch",
    "test:coverage": "npx --node-options=--experimental-vm-modules jest --coverage"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [".js"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "verbose": true,
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": -10
      }
    }
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}