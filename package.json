{
  "name": "kip-31-core-testing",
  "version": "0.1.0",
  "description": "Core testing framework for KIP-31",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules --loader ts-node/esm ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --loader ts-node/esm ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules --loader ts-node/esm ./node_modules/jest/bin/jest.js --coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "extensionsToTreatAsEsm": [".js"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "verbose": true,
    "collectCoverage": true,
    "coverageProvider": "v8",
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": -10
      }
    }
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}